{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "options": {
                "baseURL": "http://localhost:11434/v1",
            },
            "models": {
                "qwen2.5-coder:14b": {
                    "name": "qwen2.5-coder:14b",
                    "tools": true,
                    "options": {
                        "max_tokens": 8192,
                        "num_ctx": 32768
                    }
                },
                "gemma4:26b-ci": {
                    "name": "gemma4:26b-ci",
                    "tools": true,
                },
                "deepseek-r1:14b": {
                    "name": "deepseek-r1:14b",
                    "tools": true
                }
            }
        }
    },
    "permission": {
        "bash": {
            "*": "allow",
            "rm -rf *": "deny",
            "git push --force*": "deny",
            "sudo *": "deny",
            "dd *": "deny",
            "mkfs*": "deny",
            "format*": "deny"
        }
    },
    "model": "ollama/gemma4:26b-ci"
}